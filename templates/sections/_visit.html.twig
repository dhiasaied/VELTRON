{# Reel 21.5s–23.0s "Hours, map, found on Google": stylised night map with the route from the subway. #}
<section class="visit theme-dark" id="visit" data-section="visit" aria-labelledby="visit-title">
    <div class="visit__grid">
        <div class="visit__info">
            <p class="eyebrow mono">09 — Find the shop</p>
            <h2 id="visit-title" class="h2">Two blocks <strong>from the L.</strong></h2>
            <p class="visit__address">214 Bedford Ave &amp; N 6th St<br>Williamsburg, Brooklyn, NY 11249</p>
            <p class="visit__phone"><a href="tel:+17185550142">(718) 555-0142</a></p>
            <ul class="hours mono">
                {% for row in hours %}<li><span>{{ row.day }}</span><span>{{ row.hours }}</span></li>{% endfor %}
            </ul>
            <a class="btn btn--ghost btn--sm" href="https://www.google.com/maps/search/?api=1&amp;query=214+Bedford+Ave+Brooklyn+NY" target="_blank" rel="noopener">Directions ↗</a>
        </div>
        <figure class="map" data-map aria-label="Map: two blocks from Bedford Av L station">
            <svg viewBox="0 0 600 440" role="img" aria-hidden="true">
                <defs>
                    <linearGradient id="mapFade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#151517"/><stop offset="1" stop-color="#0e0e10"/></linearGradient>
                </defs>
                <rect width="600" height="440" fill="url(#mapFade)"/>
                <g class="map__blocks">
                    {% for c in 0..6 %}{% for r in 0..5 %}
                        <rect x="{{ c * 92 - 30 + (r % 2) * 10 }}" y="{{ r * 82 - 20 }}" width="78" height="66" rx="3" transform="rotate(-28 300 220)"/>
                    {% endfor %}{% endfor %}
                </g>
                <g class="map__streets" transform="rotate(-28 300 220)">
                    <path d="M-80 120 H700 M-80 202 H700 M-80 284 H700 M-80 366 H700"/>
                    <path d="M54 -100 V560 M146 -100 V560 M238 -100 V560 M330 -100 V560 M422 -100 V560 M514 -100 V560" />
                    <path class="map__avenue" d="M-80 243 H700"/>
                </g>
                <path class="map__route" data-map-route d="M150 330 L230 288 L262 238 L384 176" />
                <g class="map__station" transform="translate(150 330)"><circle r="9"/><text x="14" y="22">L · Bedford Av</text></g>
                <g class="map__pin" transform="translate(384 176)"><circle class="map__pulse" r="22"/><circle r="12"/><text x="-26" y="40">VELTRON</text></g>
            </svg>
            <figcaption class="mono">4 min walk · 2 blocks</figcaption>
        </figure>
    </div>
</section>
