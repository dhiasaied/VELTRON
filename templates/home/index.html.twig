{% extends 'base.html.twig' %}

{% block head_extra %}
    {{ include('components/_structured_data.html.twig') }}
{% endblock %}

{% block body %}
    {{ include('components/_intro.html.twig') }}
    {{ include('components/_cursor.html.twig') }}

    {# One fixed, transparent WebGL canvas. 3D objects are anchored to DOM elements below. #}
    <canvas class="webgl" data-webgl aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>

    {{ include('components/_nav.html.twig') }}

    <main id="main">
        {{ include('sections/_hero_stage.html.twig') }}
        {{ include('sections/_services.html.twig') }}
        {{ include('sections/_manifesto.html.twig') }}
        {{ include('sections/_barbers.html.twig') }}
        {{ include('sections/_lookbook.html.twig') }}
        {{ include('sections/_club.html.twig') }}
        {{ include('sections/_shop.html.twig') }}
        {{ include('sections/_gift.html.twig') }}
        {{ include('sections/_reviews.html.twig') }}
        {{ include('sections/_visit.html.twig') }}
        {{ include('sections/_faq.html.twig') }}
        {{ include('sections/_footer.html.twig') }}
    </main>

    {{ include('components/_booking_drawer.html.twig') }}
    {{ include('components/_gift_modal.html.twig') }}

    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <div hidden data-shop-config="{{ clientConfig|json_encode|e('html_attr') }}"></div>
{% endblock %}
