{#
  Opening sequence (reel 0.0s–3.0s): a field of hair with the giant wordmark; a clipper
  trailing its cord sweeps across and shaves a lane, the hair falls away to reveal the lit
  chair, and the two words travel to their places in the hero. Driven by assets/js/ui/Intro.js.
#}
<div class="intro" data-intro aria-hidden="true">
    <canvas class="intro__hair" data-intro-hair></canvas>
    <canvas class="intro__fx" data-intro-fx></canvas>
    <div class="intro__type">
        <span class="intro__word intro__word--thin" data-intro-word="thin">vel</span>
        <span class="intro__word intro__word--bold" data-intro-word="bold">tron</span>
    </div>
    <div class="intro__corner intro__corner--bl mono"><span>VELTRON</span><span>Est. 2012</span></div>
    <div class="intro__corner intro__corner--br mono"><span data-intro-count>00</span>%</div>
</div>
